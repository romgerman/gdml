{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-scons",
            "type": "process",
            "command": "scons",
            "args": [
                "dev_build=yes",
                "platform=windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "isBuildCommand": true
        }
    ]
}