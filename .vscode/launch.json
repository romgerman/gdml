{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(Windows) Debug GDExtension",
    //   "type": "lldb",
	  "type": "cppvsdbg",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceRoot}/demo",
      "program": "C:\\Code\\godot-src\\bin\\godot.windows.editor.dev.x86_64.exe",
      "args": [
        "--editor",
        "--verbose"
      ],
      "stopAtEntry": false,
      "environment": [],
	//   "stdio": null,
      "preLaunchTask": "build-scons"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Code/Godot/gdml/src",
      "program": "c:/Code/Godot/gdml/src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}