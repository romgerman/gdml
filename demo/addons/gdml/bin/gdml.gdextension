[configuration]

entry_symbol = "gdml_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://addons/gdml/bin/libgdml.macos.template_debug.framework"
macos.release = "res://addons/gdml/bin/libgdml.macos.template_release.framework"
ios.debug = "res://addons/gdml/bin/libgdml.ios.template_debug.xcframework"
ios.release = "res://addons/gdml/bin/libgdml.ios.template_release.xcframework"
windows.debug.x86_32 = "res://addons/gdml/bin/libgdml.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/gdml/bin/libgdml.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://addons/gdml/bin/libgdml.windows.template_debug.dev.x86_64.dll"
windows.release.x86_64 = "res://addons/gdml/bin/libgdml.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/gdml/bin/libgdml.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/gdml/bin/libgdml.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/gdml/bin/libgdml.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/gdml/bin/libgdml.linux.template_release.arm64.so"
linux.debug.rv64 = "res://addons/gdml/bin/libgdml.linux.template_debug.rv64.so"
linux.release.rv64 = "res://addons/gdml/bin/libgdml.linux.template_release.rv64.so"
android.debug.x86_64 = "res://addons/gdml/bin/libgdml.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/gdml/bin/libgdml.android.template_release.x86_64.so"
android.debug.arm64 = "res://addons/gdml/bin/libgdml.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/gdml/bin/libgdml.android.template_release.arm64.so"

[dependencies]
ios.debug = {
	"res://addons/gdml/bin/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
	"res://addons/gdml/bin/libgodot-cpp.ios.template_release.xcframework": ""
}