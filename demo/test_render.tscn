[sub_resource type="GDScript" id="GDScript_4tb28"]
resource_name = "inventory"
script/source = "@tool
extends GDMLNode

@export var items: Array[InventoryItem] = []

func _ready() -> void:
	if markup:
		markup.changed.connect(func ():
			get_variable(\"items\").value = items
		)
	
	get_variable(\"items\").value = items
	
	if not Engine.is_editor_hint():
		connect(\"hover\", _hovered)
		connect(\"unhover\", _unhovered)
	
	#await get_tree().create_timer(2.0).timeout
	#var item_count := get_variable(\"item_count\")
	#item_count.value = 3

func _hovered() -> void:
	var item_color := get_variable(\"stylebox\")
	item_color.value.bg_color = Color.YELLOW

func _unhovered() -> void:
	var item_color := get_variable(\"stylebox\")
	item_color.value.bg_color = Color.BLACK
"

