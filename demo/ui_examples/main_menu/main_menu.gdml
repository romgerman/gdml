# @reference: main_menu.gd

VBoxContainer {
	alignment: 1
	anchor_left: 0.0
	anchor_top: 0.0
	anchor_right: 1.0
	anchor_bottom: 1.0
	position.x: NOTIFICATION_ENTER_TREE
	grow_horizontal: GrowDirection.GROW_DIRECTION_END
	grow_vertical: GrowDirection.GROW_DIRECTION_END
	
	Label {
		text: game_name
		label_settings: LabelSettings {
			font_size: 32
		}
	}
	
	Button {
		text: "Continue"
	}
	
	Button { text: "New Game"; }
	Button { text: "Settings"; }
	Button { text: "Authors"; }
	Button { text: "Quit"; }
}
