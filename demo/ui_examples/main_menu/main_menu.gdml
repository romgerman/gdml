# @reference: main_menu.gd

VBoxContainer {
	name: "MainMenu"
	alignment: 1
	anchor_left: 0.0
	anchor_top: 0.0
	anchor_right: 1.0
	anchor_bottom: 1.0
	grow_horizontal: GrowDirection.GROW_DIRECTION_BOTH
	grow_vertical: GrowDirection.GROW_DIRECTION_END
	alignment: AlignmentMode.ALIGNMENT_END
	
	Label {
		text: game_name
		label_settings: LabelSettings {
			font_size: 32
		}
		text: test_raw_fn()
		theme: load("res://ui_examples/main_menu/game_name.tres")
	}
	
	Button {
		text: "Continue"
		@pressed: continue_pressed
	}
	
	Button { text: "New Game"; }
	Button { text: "Settings"; }
	Button { text: "Authors"; }
	Button { text: "Quit"; }
}
