[gd_scene format=3 uid="uid://dycyjbyx585f5"]

[ext_resource type="Script" uid="uid://dvhxyroq3eful" path="res://ui_examples/character_screen/character_screen.gdml" id="1_o83dp"]

[sub_resource type="GDScript" id="GDScript_o83dp"]
script/source = "@tool
extends GDMLNode

func _ready() -> void:
	await get_tree().create_timer(0.5).timeout
	var stats := get_variable_value(\"stats\") as Dictionary
	stats.erase(\"health\")
	stats.erase(\"mana\")
	stats[\"fuckality\"] = 350
	get_variable(\"stats\").value = stats
	print(get_variable_value(\"stats\"))
	
	connect(\"minus_pressed\", _on_minus_pressed)
	connect(\"plus_pressed\", _on_plus_pressed)

func _on_minus_pressed(ctrl: Control) -> void:
	var key: String = ctrl.name.replace(\"minus_\", \"\")
	
	var stats: Dictionary = get_variable_value(\"stats\")
	stats.set(key, stats.get(key, 0) - 1)
	get_variable(\"stats\").value = stats

func _on_plus_pressed(ctrl: Control) -> void:
	var key: String = ctrl.name.replace(\"plus_\", \"\")
	
	var stats: Dictionary = get_variable_value(\"stats\")
	stats.set(key, stats.get(key, 0) + 1)
	get_variable(\"stats\").value = stats
"

[node name="CharacterScreen" type="GDMLNode" unique_id=138545206]
