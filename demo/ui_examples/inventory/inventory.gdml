let item_size = Vector2 {
	x: 100
	y: 100
}

let stylebox = StyleBoxFlat {
	bg_color: Color.BLACK
}

let ItemComponent = Control {
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
}

let items = [
	{ item_name: "Test Item"; item_icon: MyCoolButton.load_res("res://icon.svg"); }
]

signal hover
signal unhover

GridContainer {
	columns: 5
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
	
	@for item_info in items {
		PanelContainer {
			custom_minimum_size: item_size
			$panel: stylebox
			@mouse_entered: hover
			@mouse_exited: unhover
			
			TextureRect {
				texture: item_info.item_icon
			}
			  
			ColorRect {
				color: Color {
					r: 0; g: 0; b: 0;
					a: 0.5;
				}
			}
			
			Button {
				text: self.name
				#text: item_info.item_name
				$normal: StyleBoxEmpty {}
			}
		}
	}
}
