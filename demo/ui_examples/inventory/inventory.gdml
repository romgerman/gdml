let item_size = Vector2 {
	x: 100
	y: 100
}

let stylebox = StyleBoxFlat {
	bg_color: Color.BLACK
}

let ItemComponent = Control {
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
}

let items = [
	{ item_name: "Test Item"; item_icon: MyCoolButton.load_res("res://icon.svg"); }
]

signal item_gui_input

GridContainer {
	columns: 5
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
	
	@for item_info in items {
		PanelContainer {
			custom_minimum_size: item_size
			$panel: stylebox
			
			DropTarget {
				Control(anchors(0, 0, 1, 1)) {
					ColorRect {
						color: Color {
							r: 0; g: 0; b: 0;
							a: 0.5;
						}
						mouse_filter: Control.MOUSE_FILTER_IGNORE
					}
					
					TextureRect(anchors(0, 0, 1, 1)) {
						texture: item_info.item_icon
						expand_mode: TextureRect.EXPAND_FIT_HEIGHT_PROPORTIONAL
						mouse_filter: Control.MOUSE_FILTER_IGNORE
					}
					
					Button(anchors(0, 0, 1, 1)) {
						@gui_input: item_gui_input
						$normal: StyleBoxEmpty {}
						
						Label {
							text: item_info.item_name
						}
					}
				}
			}
		}
	}
}
