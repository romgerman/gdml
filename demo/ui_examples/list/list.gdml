let items = [1, 2, 3, 4, 5]
let item_refs = {}
let trans_in
let trans_out
let is_trans_enabled = true

# TODO: doesn't "re-render" resources
let trans_enter = GDMLTransitionEnter { tween_factory: trans_in; enabled: is_trans_enabled; }
let trans_exit = GDMLTransitionExit { tween_factory: trans_out; enabled: is_trans_enabled; }


let handle_sb = StyleBoxFlat {
	bg_color: Color.WHITE
}

signal item_drag_handle_input
signal add_items
signal delete_item

component DragHandle = Control {
	name: "DragHandle"
	custom_minimum_size.x: 32
	mouse_filter: Control.MOUSE_FILTER_PASS
	@gui_input: item_drag_handle_input
	
	VBoxContainer(anchors(0, 0, 1, 1)) {
		alignment: BoxContainer.ALIGNMENT_CENTER
		mouse_filter: Control.MOUSE_FILTER_IGNORE
		
		@for _ in 3 {
			Panel {
				custom_minimum_size.y: 1
				custom_minimum_size.x: 10
				size_flags_horizontal: Container.SIZE_SHRINK_CENTER
				mouse_filter: Control.MOUSE_FILTER_IGNORE
				$panel: handle_sb
			}
		}
	}
}

ScrollContainer(anchors(0, 0, 1, 1)) {
	VBoxContainer {
		size_flags_horizontal: Container.SIZE_EXPAND_FILL
		
		@for i, value in items {
			PanelContainer(
				ref(item_refs, i),
				transition(GDMLTransitionEnter {
					tween_factory: trans_in
					enabled: is_trans_enabled
				}),
				transition(GDMLTransitionExit {
					tween_factory: trans_out
					enabled: is_trans_enabled
				})
			) {
				offset_transform_enabled: true
				mouse_filter: Control.MOUSE_FILTER_PASS
				
				HBoxContainer {
					Label {
						text: value
						size_flags_horizontal: Container.SIZE_EXPAND_FILL
					}
					
					Button {
						text: "delete"
						flat: true
						$font_color: Color.RED
						@pressed: delete_item
					}
					
					DragHandle {}
				}
			}
		}
		
		PanelContainer {
			mouse_filter: Control.MOUSE_FILTER_PASS
			
			Button {
				text: "add items"
				@pressed: add_items
			}
		}
	}
}
