let item_size = Vector2 {
	x: 100
	y: 100
}

let stylebox = StyleBoxFlat {
	bg_color: Color.WHITE
}

let item_count = 10
let items = [Color.WHITE, Color.BLACK]

signal hover
signal unhover

GridContainer {
	columns: 5
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
	
	@for color in items {
		ColorRect {
			custom_minimum_size: item_size
			color: color
		}
		#Panel {
		#	custom_minimum_size: item_size
		#	$panel: stylebox
		#	@mouse_entered: hover
		#	@mouse_exited: unhover
		#}
	}
}
