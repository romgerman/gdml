let item_size = Vector2 {
	x: 100
	y: 100
}

let stylebox = StyleBoxFlat {
	bg_color: Color.WHITE
}

let item_count = 10

signal hover
signal unhover

GridContainer {
	columns: 5
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
	
	@for i in item_count {
		Panel {
			custom_minimum_size: item_size
			$panel: stylebox
			@mouse_entered: hover
			@mouse_exited: unhover
		}
	}
}
