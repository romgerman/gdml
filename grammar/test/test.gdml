let item_size = Vector2 {
	x: 100
	y: 100
}

let stylebox = StyleBoxFlat {
	bg_color: Color.BLACK
}

let dt_stylebox = StyleBoxFlat {
	border_color: Color.YELLOW
	border_width_left: 2
	border_width_right: 2
	border_width_top: 2
	border_width_bottom: 2
	expand_margin_left: 2
	expand_margin_right: 2
	expand_margin_top: 2
	expand_margin_bottom: 2
}

let inventory_size = 10
let columns = 5
let items = [
	{ item_name: "Test Item"; item_icon: MyCoolButton.load_res("res://icon.svg"); }
]

signal item_gui_input

GridContainer {
	columns: columns
	anchor_left: 0.0
	anchor_right: 1.0
	anchor_top: 0.0
	anchor_bottom: 1.0
	
	@for i, item_info in items {
		Label {
			text: items.get(i).item_name
		}
		
		PanelContainer {
			custom_minimum_size: item_size
			$panel: stylebox
			
			DropTarget {
				index: i
				
				Control(anchors(0, 0, 1, 1)) {
					name: "Item"
					@gui_input: item_gui_input
					
					ColorRect {
						color: Color {
							r: 0; g: 0; b: 0;
							a: 0.5;
						}
						mouse_filter: Control.MOUSE_FILTER_IGNORE
					}
					
					TextureRect(anchors(0, 0, 1, 1)) {
						texture: item_info.item_icon
						expand_mode: TextureRect.EXPAND_FIT_HEIGHT_PROPORTIONAL
						mouse_filter: Control.MOUSE_FILTER_IGNORE
					}
					
					Button(anchors(0, 0, 1, 1)) {
						$normal: StyleBoxEmpty {}
						mouse_filter: Control.MOUSE_FILTER_PASS
						
						Label {
							text: item_info.item_name
						}
					}
				}
			}
		}
	}
}
